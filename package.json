{
  "name": "redist-icons",
  "private": true,
  "type": "module",
  "workspaces": [
    "common",
    "crates/*"
  ],
  "scripts": {
    "gen:mdi": "bun run --cwd crates/mdi gen",
    "gen:oct": "bun run --cwd crates/octicons gen",
    "gen:fa": "bun run --cwd crates/fontawesome gen",
    "gen:si": "bun run --cwd crates/simple-icons gen",
    "gen": "bun run gen:mdi && bun run gen:oct && bun run gen:fa && bun run gen:si",
    "format": "bun fmt",
    "format:check": "bun fmt --check"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "svgo": "4.1.0"
  }
}
